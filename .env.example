# Environment Configuration
# Copy this file to .env and fill in your actual values

# --- LLM Configuration ---
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4-flash:exacto
LLM_REASONING_ENABLED=true
LLM_REASONING_EFFORT=medium
LLM_REASONING_MAX_TOKENS=2000
LLM_REASONING_EXCLUDE=true
EMBEDDING_MODEL=qwen/qwen3-embedding-8b:nitro
VECTOR_SIZE=4096

# --- GLM-OCR Configuration (Zhipu AI) ---
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4/layout_parsing
GLM_OCR_MODEL=glm-ocr
GLM_LAYOUT_MODEL=glm-ocr

# --- Qdrant Vector Database ---
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=student_documents_1.2

# --- Retrieval Strategy ---
# Available strategies:
#   - "similarity" : Pure dense vector cosine similarity search
#   - "rrf"        : Hybrid reciprocal rank fusion (dense vector + BM25 sparse vector)
#   - "reranker"   : Two-stage retrieval (first-stage RRF/dense candidates re-scored by cross-encoder)
RETRIEVAL_STRATEGY=reranker
RETRIEVAL_TOP_K=10

# --- Reranker Configuration (Optional/Used when RETRIEVAL_STRATEGY=reranker) ---
# Primary provider options:
#   - "openrouter" : Remote OpenRouter reranker endpoint (e.g. cohere/rerank-v3.5, qwen/qwen3-reranker-8b)
#   - "jina"       : Remote Jina AI reranker endpoint (e.g. jina-reranker-v3)
#   - "custom"     : Custom OpenAI-compatible / Cohere-compatible reranker endpoint
#   - "local"      : Local CPU cross-encoder via FastEmbed (e.g. BAAI/bge-reranker-base)
RERANKER_PROVIDER=openrouter
RERANKER_MODEL=cohere/rerank-v3.5
RERANKER_BASE_URL=https://openrouter.ai/api/v1
# If unset, OpenRouter uses OPENAI_API_KEY (or OPENROUTER_API_KEY)
RERANKER_API_KEY=
RERANKER_CANDIDATE_MULTIPLIER=6

# --- Fallback Reranker Configuration ---
# Automatically invoked if primary reranker fails or is unavailable:
#   - "jina"  : Fallback to Jina AI remote endpoint (recommended)
#   - "local" : Fallback to local FastEmbed cross-encoder
#   - "none"  : Disable fallback (raise error immediately on primary failure)
RERANKER_FALLBACK_PROVIDER=jina
RERANKER_FALLBACK_MODEL=jina-reranker-v3
RERANKER_FALLBACK_BASE_URL=https://api.jina.ai/v1
RERANKER_FALLBACK_API_KEY=
JINA_API_KEY=your_jina_api_key_here

# --- Redis Cache ---
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=student-records-chatbot
REDIS_CACHE_TTL_SECONDS=300

# --- LangSmith Configuration ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=student-records-chatbot

# --- Application Configuration ---
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
LOG_APP_NAME=passistant
LOG_SYSLOG_FACILITY=16
DATA_DIR=data
CORS_ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=20
SESSION_MAX_ACTIVE=100

# --- Telegram Bot ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_webhook_secret_here
TELEGRAM_MAX_FILE_BYTES=20000000
# JSON list of allowed mime types, e.g. ["application/pdf", "image/jpeg", "image/png"]
TELEGRAM_ALLOWED_FILE_MIME_TYPES=["application/pdf", "image/jpeg", "image/png"]

# --- Ragas Evaluation Configuration ---
# Optional overrides for RAGAS evaluator LLM and embedding model (defaults to LLM_MODEL / EMBEDDING_MODEL if empty)
RAGAS_LLM_MODEL=
RAGAS_EMBEDDING_MODEL=
RAGAS_LLM_REASONING_ENABLED=false
RAGAS_LLM_REASONING_MAX_TOKENS=2000
RAGAS_LLM_REASONING_EFFORT=medium
RAGAS_LLM_REASONING_EXCLUDE=false

# --- Chunking Configuration ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# JSON list of chunk separators
CHUNK_SEPARATORS=["\n\n", "\n", ". ", " ", ""]
