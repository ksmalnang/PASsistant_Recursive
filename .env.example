# Environment Configuration
# Copy this file to .env and fill in your actual values

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-v4-flash:exacto
LLM_REASONING_ENABLED=true
LLM_REASONING_EFFORT=medium
LLM_REASONING_MAX_TOKENS=2000
LLM_REASONING_EXCLUDE=true
EMBEDDING_MODEL=qwen/qwen3-embedding-8b:nitro
VECTOR_SIZE=4096

# GLM-4 OCR Configuration (Zhipu AI)
ZHIPU_API_KEY=your_zhipu_api_key_here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_OCR_MODEL=glm-ocr
GLM_LAYOUT_MODEL=glm-ocr

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=student_documents
RETRIEVAL_STRATEGY=reranker
RETRIEVAL_TOP_K=10
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
RERANKER_BASE_URL=https://api.jina.ai/v1
RERANKER_API_KEY=your_reranker_api_key_here
RERANKER_CANDIDATE_MULTIPLIER=6

# Redis Cache
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=student-records-chatbot
REDIS_CACHE_TTL_SECONDS=300

# LangSmith Configuration
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=student-records-chatbot

# Application Configuration
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DATA_DIR=data
CORS_ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=20

# Telegram Bot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.example.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET_TOKEN=your_webhook_secret_here
TELEGRAM_MAX_FILE_BYTES=20000000
TELEGRAM_ALLOWED_FILE_MIME_TYPES=

# Ragas Configuration
RAGAS_LLM_MODEL=
RAGAS_EMBEDDING_MODEL=
RAGAS_LLM_REASONING_ENABLED=true
RAGAS_LLM_REASONING_MAX_TOKENS=
RAGAS_LLM_REASONING_EFFORT=low
RAGAS_LLM_REASONING_EXCLUDE=true

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# CHUNK_SEPARATORS defaults to ["\n\n", "\n", ". ", " ", ""]
